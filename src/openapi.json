    "/api/v1/enqueue": {
      "post": {
        "summary": "Enqueue one or more jobs",
        "tags": ["Jobs"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "oneOf": [
                  { "$ref": "#/components/schemas/EnqueueRequest" },
                  { "$ref": "#/components/schemas/EnqueueBatchRequest" }
                ]
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Job or jobs created" },
          "409": { "description": "Unique conflict" }
        }
      }
    },
