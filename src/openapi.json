  },
  "components": {
    "schemas": {
      "EnqueueRequest": {
        "type": "object",
        "required": ["queue"],
        "properties": {
          "queue": { "type": "string" },
          "payload": {},
          "priority": {
            "oneOf": [
              { "type": "integer", "minimum": 0, "maximum": 100 },
              { "type": "string", "enum": ["critical", "high", "normal", "low"] }
            ]
          },
          "max_retries": { "type": "integer", "minimum": 0, "maximum": 100, "default": 3 },
          "retry_backoff": { "type": "string", "enum": ["exponential", "linear"], "default": "exponential" },
          "retry_base_delay_ms": { "type": "integer" },
          "retry_max_delay_ms": { "type": "integer" },
          "unique_key": { "type": "string" },
          "unique_period": { "type": "integer" },
          "tags": {
            "type": "object",
            "additionalProperties": true
          },
          "checkpoint": {},
          "group": { "type": "string" },
          "scheduled_at": { "type": "string", "format": "date-time" },
          "batch_id": { "type": "string" },
          "parent_id": { "type": "string" },
          "chain_id": { "type": "string" },
          "chain_step": { "type": "integer" },
          "chain_config": {},
          "chain": {},
          "expire_after_ms": { "type": "integer" }
        }
      },
      "EnqueueBatchRequest": {
        "type": "object",
        "required": ["jobs"],
        "properties": {
          "jobs": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/EnqueueRequest" }
          }
        }
      },
      "FetchRequest": {
        "type": "object",
        "required": ["queues"],
        "properties": {
          "queues": {
            "type": "array",
            "items": { "type": "string" }
          },
          "worker_id": { "type": "string" },
          "hostname": { "type": "string" },
          "count": { "type": "integer", "minimum": 1, "maximum": 512, "default": 1 }
        }
      },
      "AckRequest": {
        "type": "object",
        "properties": {
          "result": {},
          "checkpoint": {},
          "ack_status": { "type": "string", "enum": ["done", "hold"] },
          "hold_reason": { "type": "string" },
          "lease_token": { "type": "integer" }
        }
      },
      "AckBatchItem": {
        "type": "object",
        "required": ["job_id"],
        "properties": {
          "job_id": { "type": "string" },
          "result": {},
          "checkpoint": {},
          "ack_status": { "type": "string", "enum": ["done", "hold"] },
          "hold_reason": { "type": "string" }
        }
      },
      "AckBatchRequest": {
        "type": "object",
        "properties": {
          "acks": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/AckBatchItem" }
          },
          "job_ids": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      },
      "FailRequest": {
        "type": "object",
        "properties": {
          "error": { "type": "string" },
          "backtrace": { "type": "string" },
          "lease_token": { "type": "integer" }
        }
      },
      "HeartbeatRequest": {
        "type": "object",
        "required": ["worker_id"],
        "properties": {
          "worker_id": { "type": "string" },
          "jobs": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["job_id"],
              "properties": {
                "job_id": { "type": "string" },
                "progress": {},
                "checkpoint": {}
              }
            }
          }
        }
      },
      "MoveJobRequest": {
        "type": "object",
        "required": ["queue"],
        "properties": {
          "queue": { "type": "string" }
        }
      },
      "BulkRequest": {
        "type": "object",
        "required": ["action", "job_ids"],
        "properties": {
          "action": {
            "type": "string",
            "enum": ["delete", "cancel", "move", "requeue", "change_priority", "hold", "approve", "reject", "promote"]
          },
          "job_ids": {
            "type": "array",
            "items": { "type": "string" }
          },
          "move_to_queue": { "type": "string" },
          "priority": { "type": "integer", "minimum": 0, "maximum": 255 }
        }
      },
      "JobIdListRequest": {
        "type": "object",
        "required": ["job_ids"],
        "properties": {
          "job_ids": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      },
      "JobSearchRequest": {
        "type": "object",
        "properties": {
          "payload_contains": { "type": "string" },
          "queue": { "type": "string" },
          "state": {
            "type": "array",
            "items": { "type": "string" }
          },
          "limit": { "type": "integer", "minimum": 1, "maximum": 500, "default": 100 },
          "offset": { "type": "integer", "minimum": 0, "default": 0 }
        }
      },
      "QueueConcurrencyRequest": {
        "type": "object",
        "properties": {
          "max": { "type": "integer", "minimum": 0 }
        }
      },
      "QueueThrottleRequest": {
        "type": "object",
        "properties": {
          "rate": { "type": "integer", "minimum": 0 },
          "window_ms": { "type": "integer", "minimum": 0, "default": 1000 }
        }
      },
      "GlobalThrottleRequest": {
        "type": "object",
        "properties": {
          "rate": { "type": "integer", "minimum": 0 },
          "window_ms": { "type": "integer", "minimum": 0, "default": 1000 }
        }
      },
      "BatchCreateRequest": {
        "type": "object",
        "properties": {
          "callback_queue": { "type": "string" },
          "callback_payload": {}
        }
      },
      "CronRequest": {
        "type": "object",
        "required": ["name", "queue", "schedule"],
        "properties": {
          "name": { "type": "string" },
          "queue": { "type": "string" },
          "schedule": { "type": "string" },
          "timezone": { "type": "string", "default": "UTC" },
          "payload": {},
          "max_retries": { "type": "integer" },
          "unique_key": { "type": "string" },
          "enabled": { "type": "boolean", "default": true }
        }
      },
      "CronUpdateRequest": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "queue": { "type": "string" },
          "schedule": { "type": "string" },
          "timezone": { "type": "string" },
          "payload": {},
          "max_retries": { "type": "integer" },
          "unique_key": { "type": "string" },
          "enabled": { "type": "boolean" }
        }
      },
      "BudgetRequest": {
        "type": "object",
        "required": ["scope", "target"],
        "properties": {
          "scope": { "type": "string", "enum": ["queue", "global"] },
          "target": { "type": "string" },
          "daily_usd": { "type": "number" },
          "per_job_usd": { "type": "number" },
          "on_exceed": { "type": "string", "enum": ["block", "warn"], "default": "block" }
        }
      },
      "ApiKeyCreateRequest": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "role": { "type": "string", "enum": ["admin", "worker", "producer"], "default": "admin" }
        }
      },
      "ApiKeyDeleteRequest": {
        "type": "object",
        "required": ["key_hash"],
        "properties": {
          "key_hash": { "type": "string" }
        }
      },
      "WebhookCreateRequest": {
        "type": "object",
        "required": ["url"],
        "properties": {
          "url": { "type": "string", "format": "uri" },
          "queue": { "type": "string", "default": "*" },
          "events": {
            "type": "array",
            "items": { "type": "string", "enum": ["job.completed", "job.failed", "job.dead"] }
          }
        }
      },
      "WebhookDeleteRequest": {
        "type": "object",
        "required": ["id"],
        "properties": {
          "id": { "type": "string" }
        }
      },
      "ClusterJoinRequest": {
        "type": "object",
        "required": ["node_id", "addr"],
        "properties": {
          "node_id": { "type": "string" },
          "addr": { "type": "string", "description": "IP:port" }
        }
      }
    },
    "securitySchemes": {
      "ApiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key"
      }
    }
  },
  "security": [
    { "ApiKeyAuth": [] }
  ]
}
