    "/api/v1/backup": {
      "post": {
        "summary": "Create a backup snapshot",
        "tags": ["Admin"],
        "responses": {
          "200": { "description": "Backup metadata returned" }
        }
      }
    },
    "/api/v1/backup/{id}": {
      "get": {
        "summary": "Download a backup chunk",
        "tags": ["Admin"],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "file", "in": "query", "required": true, "schema": { "type": "string", "enum": ["talon.db", "talon.vlog"] } },
          { "name": "offset", "in": "query", "schema": { "type": "integer", "minimum": 0 } },
          { "name": "length", "in": "query", "schema": { "type": "integer", "minimum": 1, "maximum": 60000 } }
        ],
        "responses": {
          "200": {
            "description": "Backup chunk",
            "content": {
              "application/octet-stream": {
                "schema": { "type": "string", "format": "binary" }
              }
            }
          }
        }
      },
      "delete": {
        "summary": "Delete a backup snapshot",
        "tags": ["Admin"],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Backup deleted" }
        }
      }
    },
    "/api/v1/restore": {
      "post": {
        "summary": "Initialize a restore upload",
