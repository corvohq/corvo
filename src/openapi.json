        "parameters": [
          { "name": "queue", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "priority", "in": "query", "schema": { "type": "string" }, "description": "Priority name such as critical, high, normal, or low." },
          { "name": "unique_key", "in": "query", "schema": { "type": "string" } },
          { "name": "max_retries", "in": "query", "schema": { "type": "integer" } },
          { "name": "scheduled_at", "in": "query", "schema": { "type": "string", "format": "date-time" } }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": true
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Job created" }
        }
      }
    },
    "/api/v1/audit-logs": {
      "get": {
