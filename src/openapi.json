          "200": { "description": "Restore session created" }
        }
      }
    },
    "/api/v1/restore/{id}": {
      "put": {
        "summary": "Upload a restore chunk",
        "tags": ["Admin"],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "file", "in": "query", "required": true, "schema": { "type": "string", "enum": ["talon.db", "talon.vlog"] } },
          { "name": "offset", "in": "query", "schema": { "type": "integer", "minimum": 0 } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/octet-stream": {
              "schema": { "type": "string", "format": "binary" }
            }
          }
        },
        "responses": {
          "200": { "description": "Restore chunk written" }
        }
      }
    },
    "/api/v1/restore/{id}/apply": {
      "post": {
